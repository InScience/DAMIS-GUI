# Production settings of the Docker stack: copied to DAMIS-GUI/.env by deploy/switch-to-docker.sh, which fills in
# the values below (random passwords, the certificate of the old Apache site). .env is gitignored; keep it 600.

# docker compose in this directory always uses the production overlay
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

SITE_DOMAIN=damis.midas.lt
HTTP_PORT=80
HTTPS_PORT=443
SSL_CERTIFICATE=/root/cert/midas.lt.crt
SSL_CERTIFICATE_KEY=/root/cert/midas.lt.key
SSL_CERTIFICATE_CHAIN=/root/cert/chain.midas.lt.crt

# www-data in the php container = the owner of the checkout
DOCKER_UID=1000
DOCKER_GID=1000

APP_SECRET=__random__
MYSQL_DATABASE=damis_db
MYSQL_USER=damis
MYSQL_PASSWORD=__random__
MYSQL_ROOT_PASSWORD=__random__

# Mail (password reset, registration). null://null = nothing is sent. Use the SMTP server given by the
# university IT, e.g. smtp://user:password@smtp.example.lt:587 (special characters URL-encoded).
MAILER_DSN=null://null
